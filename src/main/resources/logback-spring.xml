<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

    <property
            name="LOG_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | requestId=%X{requestId:-system} | %msg%n"
    />

    <!-- Log hiển thị trên console -->
    <appender
            name="CONSOLE"
            class="ch.qos.logback.core.ConsoleAppender"
    >
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- lưu hoạt động API và lỗi -->
    <appender
            name="API_FILE"
            class="ch.qos.logback.core.rolling.RollingFileAppender"
    >
        <file>${LOG_DIR}/api.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy"
        >
            <fileNamePattern>
                ${LOG_DIR}/archive/api-%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ghi request API vào file -->
    <logger
            name="com.kevin.be_laptop4you.filter.ApiLoggingFilter"
            level="INFO"
            additivity="false"
    >
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="API_FILE"/>
    </logger>

    <!-- ghi exception vào file -->
    <logger
            name="com.kevin.be_laptop4you.exception.GlobalExceptionHandler"
            level="INFO"
            additivity="false"
    >
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="API_FILE"/>
    </logger>

    <!-- Log Spring, Hibernate, Tomcat hiện trên console -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>